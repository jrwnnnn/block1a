---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import logo from "../assets/images/ui/logo.webp";
---

<Layout footer={false}>
	<main
		class="flex h-screen flex-col items-center justify-center text-[#f1f5e9]"
	>
		<Image src={logo} class="w-40 pb-5" alt="Logo" />
		<div class="text-center text-balance">
			<p class="text-center text-4xl font-bold md:text-5xl">404: Not Found</p>
			<p class="text-center">The page you are looking for does not exist.</p>
		</div>
	</main>
</Layout>
