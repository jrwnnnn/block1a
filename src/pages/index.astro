---
import { Image } from "astro:assets";
import { type Status, getServerStatus } from "../lib/mcsrvstat.ts";
import BluemapCard from "../components/BluemapCard.astro";
import CopyServerIP from "../components/CopyServerIP.astro";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import PlayerList from "../components/PlayerList.astro";

import hero from "../assets/images/backgrounds/lush_cave.webp";

let serverStatus: Status | null = null;
try {
	serverStatus = await getServerStatus();
} catch (e) {
	console.error(e);
}
---

<Layout title="Block1A">
	<Navigation />
	<CopyServerIP />

	<Image
		src={hero}
		alt="hero"
		class="h-[50vh] object-cover object-center"
	/>

	<main class="my-5 grid gap-5 md:grid-cols-[2fr_1fr]">
		<section class="flex flex-col gap-5">
			<div>
				<p class="mb-3 text-lg font-bold">About the server</p>
				<p>
					The server kicked off on December 10, 2024, right before Christmas
					break, when six founding players, AmeIgarashi, keiNoRead, umiji,
					Aihtsetnys, linolino88, and Zorith_Fortuna, spun up a little Minecraft
					server for the holidays. Since then, opening a server for the holidays
					has become a bit of a tradition, with each season adding its own
					memories while keeping the same vibe that defined the server from its
					very first day.
				</p>
			</div>

			{serverStatus && serverStatus.online ? <BluemapCard /> : null}
		</section>
		<section>
			<div class="mb-3 flex items-baseline justify-between">
				<p class="text-lg font-bold">Players</p>
			</div>
			<PlayerList />
		</section>
	</main>
</Layout>
