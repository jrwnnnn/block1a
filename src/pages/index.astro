---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import PlayerList from "../components/PlayerList.astro";

import splash from "../assets/images/backgrounds/lush_cave.webp";
import map from "../assets/images/ui/map.webp";
import warning from "../assets/images/ui/warning.webp";
---

<Layout title="Block1A">
	<Navigation />
	<div class="flex items-center justify-center gap-2 bg-red-600 py-1">
		<Image
			src={warning}
			class="mr-2 inline w-5 invert md:w-4"
			alt="Warning Icon"
		/>
		<p class="text-sm font-semibold">The server is currently offline.</p>
	</div>

	<Image
		src={splash}
		alt="splash"
		class="h-[50vh] object-cover object-center"
	/>

	<main class="my-5 grid gap-8 md:grid-cols-[2fr_1fr]">
		<section class="flex flex-col gap-5">
			<div>
				<p class="mb-3 text-lg font-bold">About the server</p>
				<p>
					This server kicked off on December 10, 2024, right before Christmas
					break. It started as a chill place for just 6 OG players (AmeIgarashi,
					keiNoRead, umiji, Aihtsetnys, linolino88, Zorith_Fortuna), playing for
					fun on Aternos. Since then, things have grown, we've moved to a
					premium server for smoother experience and more cool stuff to do. It's
					still the same cozy vibe, just better performance and more space to
					hang out.
				</p>
			</div>

			<a
				href="/bluemap"
				class="group relative block h-64 overflow-hidden rounded-md"
			>
				<div
					class="h-full bg-cover bg-center transition duration-300 group-hover:scale-105"
					style={`background-image: url(${map.src})`}
				>
				</div>
				<div class="absolute inset-x-0 bottom-0 bg-[#0d1b1d]/90 px-4 py-3">
					<p class="text-sm text-[#a6c0b8]">Open interactive world map</p>
				</div>
			</a>
		</section>
		<section>
			<div class="mb-3 flex items-baseline justify-between">
				<p class="text-lg font-bold">Players</p>
			</div>
			<PlayerList />
		</section>
	</main>
</Layout>
