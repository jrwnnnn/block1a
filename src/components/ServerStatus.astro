---
import { Image } from "astro:assets";
import { type Status, getServerStatus } from "../lib/mcsrvstat.ts";
import server_offline_icon from "../assets/images/ui/server_offline.webp";
import user_icon from "../assets/images/ui/user.webp";

let serverStatus: Status | null = null;
try {
	serverStatus = await getServerStatus();
} catch (e) {
	console.error(e);
}
---

<div>
	{
		serverStatus ? (
			serverStatus.online ? (
				<div class="flex items-center gap-2 opacity-50">
					<Image src={user_icon} alt="User Icon" class="w-5 invert" />
					<p>
						{serverStatus.players.online}/{serverStatus.players.max}
					</p>
				</div>
			) : (
				<div class="flex items-center gap-2 opacity-50">
					<Image
						src={server_offline_icon}
						alt="Server Offline"
						class="w-5 invert"
					/>
					<p>Offline</p>
				</div>
			)
		) : (
			<div class="flex items-center gap-2 opacity-50">
				<Image
					src={server_offline_icon}
					alt="Server Offline"
					class="w-5 invert"
				/>
				<p>Unavailable</p>
			</div>
		)
	}
</div>
