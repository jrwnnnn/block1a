---
import { Image } from "astro:assets";

import discord from "../assets/images/ui/footer/discord.webp";
import instagram from "../assets/images/ui/footer/instagram.webp";
import twitter from "../assets/images/ui/footer/twitter.webp";
---

<footer
	class="flex flex-col items-center justify-center gap-5 bg-[#1A212B] py-10"
>
	<div class="flex gap-10 invert">
		<Image
			src={twitter}
			alt="twitter"
			class="w-9 hover:cursor-pointer"
			onclick="window.open('https://x.com/block1a_')"
		/>
		<Image
			src={discord}
			alt="discord"
			class="w-10 hover:cursor-pointer"
			onclick="window.open('https://discord.gg')"
		/>
		<Image
			src={instagram}
			alt="instagram"
			class="w-10 hover:cursor-pointer"
			onclick="window.open('https://www.instagram.com/block1a_/')"
		/>
	</div>
	<div class="text-center text-xs text-balance text-gray-400 md:mx-0">
		<p>&copy; 2024-2025, Block1A Server - All rights reserved.</p>
		<p>
			Not affiliated with Mojang, AB. Nor should we be considered a server
			endorsed by Mojang, AB.
		</p>
	</div>
</footer>
